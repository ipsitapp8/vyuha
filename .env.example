# Used by docker-compose.yml (copy to .env at repo root)
POSTGRES_USER=vyuha
POSTGRES_PASSWORD=vyuha_dev_password
POSTGRES_DB=vyuha
# Required, 32+ random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# offline = bundled PMTiles base map (no internet needed), online = hosted style at VITE_MAP_STYLE_URL
MAP_MODE=offline
