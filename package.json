{
  "name": "vyuha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VYUHA (Virtual Yuddh-abhyas Under Hampered Awareness) - SIH 26248",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @vyuha/server dev\" \"pnpm --filter @vyuha/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @vyuha/server db:migrate",
    "db:seed": "pnpm --filter @vyuha/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
