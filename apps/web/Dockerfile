FROM node:24-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
ARG VITE_API_URL=http://localhost:4000
ARG VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
ARG VITE_MAP_MODE=offline
ARG VITE_SHOW_DEMO_LOGIN=false
ENV VITE_API_URL=$VITE_API_URL VITE_MAP_STYLE_URL=$VITE_MAP_STYLE_URL VITE_MAP_MODE=$VITE_MAP_MODE \
    VITE_SHOW_DEMO_LOGIN=$VITE_SHOW_DEMO_LOGIN
RUN pnpm --filter @vyuha/web build
# nginx headers generated by the build (CSP for this build's API and map hosts): config, not a page.
RUN mv apps/web/dist/nginx /repo/nginx-generated

# The official nginx build that runs as the unprivileged `nginx` user (uid 101): it listens on 8080 and
# keeps its pid and temp files under /tmp, so the container needs no root and no writable image files.
FROM nginxinc/nginx-unprivileged:alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/nginx-generated/security-headers.conf /etc/nginx/vyuha-security-headers.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
