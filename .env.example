# Used by docker-compose.yml (copy to .env at the repo root). Never commit the filled-in .env.
# Generate each secret with openssl; letters and digits only, because they end up inside URLs.

POSTGRES_USER=vyuha
# Required, random. openssl rand -hex 24
# Local development: put the same value in DATABASE_URL in apps/server/.env.
POSTGRES_PASSWORD=
POSTGRES_DB=vyuha
# Optional: host port for docker-compose.dev.yml (pnpm db:up) when 5432 is taken.
# POSTGRES_HOST_PORT=5432

# Required, 32+ random characters. openssl rand -hex 32
JWT_SECRET=

# Password of the demo accounts created on start (SEED_ON_START=true, the default).
# Required in the Docker stack: 12+ characters, never the published demo password. openssl rand -hex 16
SEED_PASSWORD=
# SEED_ON_START=true

# Optional: enables GET /metrics (Prometheus text) for a scraper sending "Authorization: Bearer <token>".
# Empty = no metrics endpoint. openssl rand -hex 32
METRICS_TOKEN=

# offline = bundled PMTiles base map (no internet needed), online = hosted style at VITE_MAP_STYLE_URL
MAP_MODE=offline
