# Local development (pnpm dev). Production settings come from docker-compose.yml or the host.
NODE_ENV=development
PORT=4000
# Password = POSTGRES_PASSWORD from the root .env (the database started with pnpm db:up).
DATABASE_URL=postgresql://vyuha:<POSTGRES_PASSWORD>@localhost:5432/vyuha
# Accepted in development only; production refuses this placeholder. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info
# Optional in development (the demo accounts then use the published demo password); required in production.
# SEED_PASSWORD=
